{
  "name": "thermaldesk",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "contracts"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev --workspace @thermaldesk/web",
    "build": "npm run build --workspace @thermaldesk/web",
    "start": "npm run start --workspace @thermaldesk/web",
    "typecheck": "tsc --noEmit",
    "test": "npm run test --workspace @thermaldesk/coordination && npm run test --workspace @thermaldesk/intake && vitest run && npm run test --workspace @thermaldesk/analysis",
    "test:system": "node scripts/system-test.mjs",
    "contracts:generate": "node contracts/generate.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "json-schema-to-typescript": "^16.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
