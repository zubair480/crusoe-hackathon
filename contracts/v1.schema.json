{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ThermalDesk exchange envelope v1",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "InspectionPackage"
        },
        "data": {
          "$ref": "#/$defs/InspectionPackage"
        }
      },
      "required": [
        "kind",
        "data"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "Recommendation"
        },
        "data": {
          "$ref": "#/$defs/Recommendation"
        }
      },
      "required": [
        "kind",
        "data"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "RepairJob"
        },
        "data": {
          "$ref": "#/$defs/RepairJob"
        }
      },
      "required": [
        "kind",
        "data"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "CompletionEvidence"
        },
        "data": {
          "$ref": "#/$defs/CompletionEvidence"
        }
      },
      "required": [
        "kind",
        "data"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "VerificationDraft"
        },
        "data": {
          "$ref": "#/$defs/VerificationDraft"
        }
      },
      "required": [
        "kind",
        "data"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "ActionReceipt"
        },
        "data": {
          "$ref": "#/$defs/ActionReceipt"
        }
      },
      "required": [
        "kind",
        "data"
      ]
    }
  ],
  "$defs": {
    "IntegrationMode": {
      "enum": [
        "live",
        "sandbox",
        "simulated"
      ]
    },
    "Evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "thermal_image",
            "photo",
            "transcript",
            "note",
            "measurement",
            "receipt",
            "equipment_history"
          ]
        },
        "asset_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "enum": [
            "plaud",
            "upload",
            "import",
            "synthetic"
          ]
        },
        "mode": {
          "$ref": "#/$defs/IntegrationMode"
        },
        "uri": {
          "type": "string",
          "minLength": 1
        },
        "captured_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "text": {
          "type": "string"
        },
        "provider_record_id": {
          "type": "string",
          "minLength": 1
        },
        "segments": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "text": {
                "type": "string"
              },
              "start_seconds": {
                "type": "number",
                "minimum": 0
              },
              "end_seconds": {
                "type": "number",
                "minimum": 0
              },
              "speaker": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "text"
            ]
          }
        }
      },
      "required": [
        "id",
        "kind",
        "asset_id",
        "source",
        "mode",
        "uri",
        "captured_at"
      ]
    },
    "Observation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string"
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "segment_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "needs_review": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "text",
        "evidence_ids",
        "segment_ids",
        "needs_review"
      ]
    },
    "InspectionPackage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "case_id": {
          "type": "string",
          "minLength": 1
        },
        "site_id": {
          "type": "string",
          "minLength": 1
        },
        "asset_id": {
          "type": "string",
          "minLength": 1
        },
        "inspection_id": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Evidence"
          }
        },
        "observations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Observation"
          }
        },
        "missing_information": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "schema_version",
        "case_id",
        "site_id",
        "asset_id",
        "inspection_id",
        "evidence",
        "observations",
        "missing_information",
        "created_at"
      ]
    },
    "Approval": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reviewer_id": {
          "type": "string",
          "minLength": 1
        },
        "recommendation_version": {
          "type": "integer",
          "minimum": 1
        },
        "approved_at": {
          "type": "string",
          "format": "date-time"
        },
        "mode": {
          "$ref": "#/$defs/IntegrationMode"
        }
      },
      "required": [
        "reviewer_id",
        "recommendation_version",
        "approved_at",
        "mode"
      ]
    },
    "Part": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "part_id": {
          "type": "string",
          "minLength": 1
        },
        "approved_specification": {
          "type": "string"
        },
        "quantity": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "unit": {
          "type": "string"
        },
        "requires_specification_review": {
          "type": "boolean"
        }
      },
      "required": [
        "part_id",
        "approved_specification",
        "quantity",
        "unit",
        "requires_specification_review"
      ]
    },
    "Finding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "severity": {
          "enum": [
            "unassessed",
            "low",
            "medium",
            "high"
          ]
        },
        "uncertainties": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "id",
        "description",
        "evidence_ids",
        "severity",
        "uncertainties"
      ]
    },
    "Recommendation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "case_id": {
          "type": "string",
          "minLength": 1
        },
        "site_id": {
          "type": "string",
          "minLength": 1
        },
        "asset_id": {
          "type": "string",
          "minLength": 1
        },
        "recommendation_id": {
          "type": "string",
          "minLength": 1
        },
        "inspection_id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "status": {
          "enum": [
            "draft",
            "needs_information",
            "approved",
            "rejected"
          ]
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Finding"
          }
        },
        "repair_scope": {
          "type": "string"
        },
        "parts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Part"
          }
        },
        "missing_information": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "approval": {
          "anyOf": [
            {
              "$ref": "#/$defs/Approval"
            },
            {
              "type": "null"
            }
          ]
        },
        "analysis_mode": {
          "$ref": "#/$defs/IntegrationMode"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "schema_version",
        "case_id",
        "site_id",
        "asset_id",
        "recommendation_id",
        "inspection_id",
        "version",
        "status",
        "findings",
        "repair_scope",
        "parts",
        "missing_information",
        "approval",
        "analysis_mode",
        "created_at"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "approved"
              }
            }
          },
          "then": {
            "properties": {
              "approval": {
                "$ref": "#/$defs/Approval"
              }
            }
          }
        }
      ]
    },
    "Authority": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "authority_id": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "$ref": "#/$defs/IntegrationMode"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "max_total_minor": {
          "type": "integer",
          "minimum": 0
        },
        "allowed_actions": {
          "type": "array",
          "items": {
            "enum": [
              "supplier_quote",
              "parts_order",
              "technician_contact",
              "booking",
              "schedule_sync",
              "manager_notify",
              "follow_up"
            ]
          }
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "authority_id",
        "mode",
        "currency",
        "max_total_minor",
        "allowed_actions",
        "expires_at"
      ]
    },
    "ActionReceipt": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "type": "string",
          "minLength": 1
        },
        "job_id": {
          "type": "string",
          "minLength": 1
        },
        "action_type": {
          "enum": [
            "supplier_quote",
            "parts_order",
            "technician_contact",
            "booking",
            "schedule_sync",
            "manager_notify",
            "follow_up"
          ]
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "$ref": "#/$defs/IntegrationMode"
        },
        "status": {
          "enum": [
            "requested",
            "pending",
            "confirmed",
            "failed",
            "not_configured"
          ]
        },
        "provider_reference": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "detail": {
          "type": "string"
        },
        "recorded_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "action_id",
        "job_id",
        "action_type",
        "idempotency_key",
        "mode",
        "status",
        "provider_reference",
        "evidence_ids",
        "detail",
        "recorded_at"
      ]
    },
    "Booking": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "technician_id": {
          "type": "string",
          "minLength": 1
        },
        "technician_name": {
          "type": "string"
        },
        "start_at": {
          "type": "string",
          "format": "date-time"
        },
        "end_at": {
          "type": "string",
          "format": "date-time"
        },
        "status": {
          "enum": [
            "proposed",
            "confirmed",
            "cancelled"
          ]
        },
        "confirmation_action_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "technician_id",
        "technician_name",
        "start_at",
        "end_at",
        "status",
        "confirmation_action_id"
      ]
    },
    "RepairJob": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "case_id": {
          "type": "string",
          "minLength": 1
        },
        "site_id": {
          "type": "string",
          "minLength": 1
        },
        "asset_id": {
          "type": "string",
          "minLength": 1
        },
        "job_id": {
          "type": "string",
          "minLength": 1
        },
        "recommendation_id": {
          "type": "string",
          "minLength": 1
        },
        "recommendation_version": {
          "type": "integer",
          "minimum": 1
        },
        "state_version": {
          "type": "integer",
          "minimum": 1
        },
        "status": {
          "enum": [
            "planning",
            "awaiting_authorization",
            "coordinating",
            "scheduled",
            "in_progress",
            "awaiting_verification",
            "closed",
            "blocked",
            "cancelled"
          ]
        },
        "authority": {
          "anyOf": [
            {
              "$ref": "#/$defs/Authority"
            },
            {
              "type": "null"
            }
          ]
        },
        "parts_status": {
          "enum": [
            "not_required",
            "not_ordered",
            "ordered",
            "available",
            "delayed"
          ]
        },
        "booking": {
          "anyOf": [
            {
              "$ref": "#/$defs/Booking"
            },
            {
              "type": "null"
            }
          ]
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ActionReceipt"
          }
        },
        "unresolved_findings": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "closure_review": {
          "anyOf": [
            {
              "$ref": "#/$defs/ClosureReview"
            },
            {
              "type": "null"
            }
          ]
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "schema_version",
        "case_id",
        "site_id",
        "asset_id",
        "job_id",
        "recommendation_id",
        "recommendation_version",
        "state_version",
        "status",
        "authority",
        "parts_status",
        "booking",
        "actions",
        "unresolved_findings",
        "closure_review",
        "updated_at"
      ]
    },
    "CompletionEvidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "case_id": {
          "type": "string",
          "minLength": 1
        },
        "site_id": {
          "type": "string",
          "minLength": 1
        },
        "asset_id": {
          "type": "string",
          "minLength": 1
        },
        "completion_id": {
          "type": "string",
          "minLength": 1
        },
        "job_id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "technician_id": {
          "type": "string",
          "minLength": 1
        },
        "reported_status": {
          "enum": [
            "complete",
            "incomplete",
            "unknown"
          ]
        },
        "comments": {
          "type": "string"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Evidence"
          }
        },
        "unresolved_items": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "schema_version",
        "case_id",
        "site_id",
        "asset_id",
        "completion_id",
        "job_id",
        "version",
        "technician_id",
        "reported_status",
        "comments",
        "evidence",
        "unresolved_items",
        "created_at"
      ]
    },
    "VerificationDraft": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "case_id": {
          "type": "string",
          "minLength": 1
        },
        "site_id": {
          "type": "string",
          "minLength": 1
        },
        "asset_id": {
          "type": "string",
          "minLength": 1
        },
        "verification_id": {
          "type": "string",
          "minLength": 1
        },
        "job_id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "recommendation_version": {
          "type": "integer",
          "minimum": 1
        },
        "completion_id": {
          "type": "string",
          "minLength": 1
        },
        "completion_version": {
          "type": "integer",
          "minimum": 1
        },
        "result": {
          "enum": [
            "ready_for_review",
            "needs_information",
            "mismatch"
          ]
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "result": {
                "enum": [
                  "pass",
                  "fail",
                  "unknown"
                ]
              },
              "evidence_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "detail": {
                "type": "string"
              }
            },
            "required": [
              "name",
              "result",
              "evidence_ids",
              "detail"
            ]
          }
        },
        "missing_information": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "analysis_mode": {
          "$ref": "#/$defs/IntegrationMode"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "schema_version",
        "case_id",
        "site_id",
        "asset_id",
        "verification_id",
        "job_id",
        "version",
        "recommendation_version",
        "completion_id",
        "completion_version",
        "result",
        "checks",
        "missing_information",
        "analysis_mode",
        "created_at"
      ]
    },
    "ClosureReview": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reviewer_id": {
          "type": "string",
          "minLength": 1
        },
        "verification_id": {
          "type": "string",
          "minLength": 1
        },
        "verification_version": {
          "type": "integer",
          "minimum": 1
        },
        "completion_version": {
          "type": "integer",
          "minimum": 1
        },
        "recommendation_version": {
          "type": "integer",
          "minimum": 1
        },
        "decision": {
          "enum": [
            "approve_closure",
            "keep_open"
          ]
        },
        "reviewed_at": {
          "type": "string",
          "format": "date-time"
        },
        "mode": {
          "$ref": "#/$defs/IntegrationMode"
        }
      },
      "required": [
        "reviewer_id",
        "verification_id",
        "verification_version",
        "completion_version",
        "recommendation_version",
        "decision",
        "reviewed_at",
        "mode"
      ]
    }
  }
}
