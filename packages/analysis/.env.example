CRUSOE_API_KEY=replace-with-an-intelligence-api-key
CRUSOE_BASE_URL=https://api.inference.crusoecloud.com/v1
# Confirm the exact model in Crusoe's current Available Models page or GET /models.
CRUSOE_MODEL=nvidia/Nemotron-3-Nano-Omni-Reasoning-30B-A3B
CRUSOE_TIMEOUT_MS=30000
CRUSOE_MAX_TOKENS=1024
CRUSOE_ENABLE_THINKING=false
# Must remain false unless a specifically authorized, guarded live request is being run.
CRUSOE_LIVE_REQUESTS_ENABLED=false
