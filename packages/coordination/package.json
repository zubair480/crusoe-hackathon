{
  "name": "@thermaldesk/coordination",
  "version": "0.1.0",
  "private": true,
  "description": "ThermalDesk repair coordinator: canonical repair-job state, persisted event history and external action adapters.",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json && node --test dist/test/*.test.js",
    "demo": "tsc -p tsconfig.json && node dist/src/demo.js"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "typescript": "5.9.3"
  }
}
