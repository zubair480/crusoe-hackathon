# Names only. Never commit real values.

# Directory for the file-backed job store (one JSON file per job).
COORDINATION_DATA_DIR=data/private/coordination

# Manager who receives repair updates. Use a consenting teammate for demos.
COORDINATION_MANAGER_ID=
COORDINATION_MANAGER_NAME=
COORDINATION_MANAGER_ADDRESS=

# Twilio SMS adapter (optional). Test credentials run in sandbox mode and send nothing.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Comma-separated E.164 numbers that may receive messages. Anything else is refused.
COORDINATION_ALLOWED_RECIPIENTS=
