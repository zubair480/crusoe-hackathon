# Copy to apps/web/.env.local and configure locally. Never commit the real key.
# Keep fixture mode and live requests disabled for development without credit usage.
# Paid requests require new user authorization before changing both settings.
THERMALDESK_ANALYSIS_MODE=fixture
CRUSOE_LIVE_REQUESTS_ENABLED=false
CRUSOE_API_KEY=
CRUSOE_MODEL=nvidia/Nemotron-3-Nano-Omni-Reasoning-30B-A3B
CRUSOE_TIMEOUT_MS=30000
CRUSOE_MAX_TOKENS=1024
CRUSOE_ENABLE_THINKING=false
THERMALDESK_DEV_FRONTEND_ORIGINS=http://localhost:8765,http://127.0.0.1:8765
# Optional absolute override; defaults to packages/coordination/agent_config.yaml.
# Credentials stay in that ignored server-side file. The app never exposes them.
BAND_AGENT_CONFIG=
# POST /api/coordination requires allowLiveBand:true to connect/post to Band.
# App Band agents prepare public supplier links, quote checks and unsent email drafts.
# The separate execution demo uses simulated suppliers and communication. No Band inference.
